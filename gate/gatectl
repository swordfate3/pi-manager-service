        print('门控操作未完成；请检查门控健康状态及 gatectl status。凭据和内部输出未显示。', file=sys.stderr)
        if len(sys.argv) > 1 and sys.argv[1] == 'up':
            print('升级预留不会自动清除；检查 upgrade-status。旧Gate不支持预留API时必须按README人工迁移，不可退回快照检查。',
                  file=sys.stderr)
        sys.exit(1)
