        epilog='''示例：./gatectl hub-management-export /绝对路径/私有目录/gate-management.json
目标必须不存在；拒绝软链接和覆盖。父目录须由当前用户所有且不可被其他用户写入。
文件为{"token":"..."}。仅供受信Hub私有配置使用，不要放入Pi工作区或聊天。
此命令不启用策略；导出失败后检查目标，选择新文件名。''', **formatting)
    management_export.add_argument('file', metavar='FILE')
    runtime_updates = sub.add_parser(
        'runtime-updates', help='只读查询全局Pi runtime策略和更新任务',
        description='查询独立runtime策略、最近任务和全部活跃任务，或查看指定任务详情。',
        epilog='''示例：
  ./gatectl runtime-updates
  ./gatectl runtime-updates <完整32位任务ID>
列表响应包含policy、jobs、active；单任务包含version、status、stage和targets等进度。''',
        **formatting)
    runtime_updates.add_argument('id', nargs='?', metavar='ID', help='可选的完整32位runtime任务ID')
    runtime_policy = sub.add_parser(
        'runtime-policy', help='独立设置全局Pi runtime更新策略和可信镜像',
        description='默认disabled；每次命令完整替换策略模式和不可变Docker镜像ID白名单。',
        epilog='''示例：
  ./gatectl runtime-policy manual --image sha256:<64位镜像ID>
  ./gatectl runtime-policy auto --image sha256:<64位镜像ID>
  ./gatectl runtime-policy disabled
--image可重复，必须是不可变本地Docker image ID，不是标签或registry digest。
初始部署应由宿主机使用已核验Pi镜像配置manual；不继承Hub或生命周期策略。''', **formatting)
    runtime_policy.add_argument('mode', choices=('disabled', 'manual', 'auto'))
    runtime_policy.add_argument('--image', action='append', default=[], metavar='SHA256_ID')
    for name in ('runtime-approve', 'runtime-reject'):
        action = '批准' if name.endswith('approve') else '拒绝'
        command = sub.add_parser(
            name, help=action + '指定全局Pi runtime更新任务',
            description=action + '已核实的完整runtime任务ID；不会授予普通Pi管理员能力。',
            epilog=f'先 ./gatectl runtime-updates <ID> 核对精确版本和目标，再 ./gatectl {name} <ID>。',
            **formatting)
        command.add_argument('id', metavar='ID')
    runtime_resolve = sub.add_parser(
        'runtime-resolve', help='记录已检查的runtime失败结果并在证据允许时解除准入阻塞',
        description='不重试、不执行更新、不把失败记为成功；仅在core证据检查通过后解除准入。',
        epilog='''示例：
  ./gatectl runtime-updates <完整32位任务ID>
  ./gatectl runtime-resolve <完整32位任务ID> --acknowledge inspected_no_mutation
先检查安装helper、共享入口和会话采用情况，确认没有未知变更后再提交固定回执。
本命令只记录检查结果；解除后由操作员另行提交新的精确版本任务，不提供resume命令。''',
        **formatting)
    runtime_resolve.add_argument('id', metavar='ID')
    runtime_resolve.add_argument('--acknowledge', choices=('inspected_no_mutation',), required=True)
    sub.add_parser('upgrade-status', help='查看持久化升级预留（不自动释放）',
                   description='预留阻止全部生命周期/部署准入；重启门控或失败不会清除。', **formatting)
    finish = sub.add_parser('upgrade-finish', help='核对替换镜像和新门控实例后完成升级预留',
                            description='通常up成功后自动完成；连接失败后先人工核查，再以精确预留ID重试。', **formatting)
    finish.add_argument('id', metavar='RESERVATION_ID')
    abort = sub.add_parser('upgrade-abort', help='确认没有待执行替换进程后显式取消升级预留',
                           description='必须先停止/确认退出原up进程并检查无未决工作；不删除任务或未知结果。', **formatting)
    abort.add_argument('id', metavar='RESERVATION_ID')
    abort.add_argument('--acknowledge', choices=('inspected_no_replacement',), required=True)
    preflight = sub.add_parser('terminal-preflight', help='Host-only read-only live terminal image check (2s budget)')
    preflight.add_argument('--image', required=True)
    args = parser.parse_args()
    if args.command == 'terminal-preflight':
        if not re.fullmatch('sha256:[0-9a-f]{64}', args.image):
            parser.error('full immutable image ID required')
        try:
            print(json.dumps(terminal_preflight(args.image)))
        except Exception:
            parser.exit(1, 'Terminal preflight unavailable. No run was admitted.\n')
    elif args.command == 'upgrade-status':
        print(json.dumps(admin('upgrade-status'), indent=2, ensure_ascii=False))
    elif args.command in ('upgrade-finish', 'upgrade-abort'):
        if not re.fullmatch('[0-9a-f]{32}', args.id):
            parser.error('full upgrade reservation ID required')
        result = (finish_upgrade(args.id) if args.command == 'upgrade-finish' else
                  admin('upgrade-abort', payload={'id': args.id, 'acknowledge': args.acknowledge}))
        print(json.dumps(result, ensure_ascii=False))
    elif args.command == 'lifecycle-export':
        export_lifecycle(args.file)
    elif args.command == 'hub-management-export':
        export_credential(args.file, 'hub-management-export')
    elif args.command == 'lifecycle':
        if args.id and not re.fullmatch('[0-9a-f]{32}', args.id):
            parser.error('full lifecycle job ID required')
        print(json.dumps(admin('lifecycle', args.id), indent=2, ensure_ascii=False))
    elif args.command == 'runtime-updates':
        if args.id and not re.fullmatch('[0-9a-f]{32}', args.id):
            parser.error('full runtime update job ID required')
        print(json.dumps(admin('runtime-updates', args.id), indent=2, ensure_ascii=False))
    elif args.command.startswith('runtime-'):
        if args.command == 'runtime-policy':
            if any(not re.fullmatch('sha256:[0-9a-f]{64}', value) for value in args.image):
                parser.error('full immutable image IDs required')
            payload = {'mode': args.mode, 'images': args.image}
        else:
            if not re.fullmatch('[0-9a-f]{32}', args.id):
                parser.error('full runtime update job ID required')
            payload = {'id': args.id}
            if args.command == 'runtime-resolve':
                payload['acknowledge'] = args.acknowledge
        print(json.dumps(admin(args.command, payload=payload), indent=2, ensure_ascii=False))
    elif args.command.startswith('lifecycle-'):
        if args.command == 'lifecycle-policy':
            if any(not re.fullmatch('sha256:[0-9a-f]{64}', value) for value in args.image):
                parser.error('full immutable image IDs required')
            payload = {'mode': args.mode, 'images': args.image}
        else:
            if not re.fullmatch('[0-9a-f]{32}', args.id):
                parser.error('full lifecycle job ID required')
            payload = {'id': args.id}
            if args.command == 'lifecycle-resolve':
                payload.update(runtime_id=args.runtime_id, acknowledge=args.acknowledge)
        print(json.dumps(admin(args.command, payload=payload), indent=2, ensure_ascii=False))
    elif args.command == 'build':
        build(ROOT, docker)
        print('可信门控镜像已构建并封存；尚未启动或更新 Hub。')
    elif args.command == 'up':
        existing = check_upgrade_ready()
        image = verified_image(ROOT, docker)
        reservation = None
        if existing:
            try:
                reservation = admin('upgrade-reserve', payload={'image': image})
                if (not isinstance(reservation, dict) or reservation.get('image') != image or
                        not isinstance(reservation.get('id'), str) or not re.fullmatch('[0-9a-f]{32}', reservation['id'])):
                    raise RuntimeError('invalid upgrade reservation')
            except Exception:
                raise RuntimeError('upgrade reservation refused/unavailable; old Gate requires explicit host migration; '
                                   'never fall back to snapshot-only replacement') from None
        # Exact ID closes the mutable-tag race. Even unchanged up must replace:
        # ordinary Compose convergence can no-op and cannot prove a new instance.
        with tempfile.NamedTemporaryFile(mode='w', prefix='pi-gate-compose-', suffix='.json') as override:
            json.dump({'services': {'gate': {'image': image}}}, override)
            override.flush()
            subprocess.run(['docker', 'compose', '--env-file', '/dev/null', '-f', str(ROOT / 'compose.yaml'),
                            '-f', override.name, 'up', '-d', '--force-recreate',
                            '--no-build', '--pull', 'never', 'gate'], check=True)
        if reservation:
            finish_upgrade(reservation['id'])
    elif args.command == 'install-client':
        install_client(args.container)
    elif args.command in ('status', 'reject', 'reject-intent', 'services', 'intents', 'events'):
        print(json.dumps(admin(args.command, getattr(args, 'id', None)), indent=2, ensure_ascii=False))
    elif args.command in ('register', 'policy', 'resume', 'resolve'):
        if args.command == 'register':
            payload = read_definition(args.file)
        elif args.command == 'policy':
            payload = {'service': args.service, 'mode': args.mode}
        elif args.command == 'resume':
            payload = {'service': args.service}
        else:
            payload = {'id': args.id, 'target_id': args.target_id}
        print(json.dumps(admin(args.command, payload=payload), indent=2, ensure_ascii=False))
    elif args.command == 'export-services':
        value = {'sanitized_summary_only': True, **admin('services')}
        descriptor = os.open(args.file, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(value, stream, indent=2, ensure_ascii=False)
            stream.write('\n')
        print('已导出脱敏服务摘要；不含运行模板、凭据，不可直接用于还原。')
    else:
        if (not re.fullmatch('[0-9a-f]{32}', args.id) or
                (args.commit and not re.fullmatch('[0-9a-f]{40}', args.commit)) or
                (args.plan and not re.fullmatch('[0-9a-f]{64}', args.plan))):
            parser.error('full request ID and exact commit or plan hash required')
        print('管理员确认：只操作该申请的目标服务；更新期间该服务可能短暂断连，保留数据卷。', flush=True)
        print(json.dumps(admin(args.command, args.id, args.commit, args.plan), ensure_ascii=False), flush=True)
        deadline = time.monotonic() + 300
        last = None
        while time.monotonic() < deadline:
            job = admin('status', args.id)
            marker = (job['status'], job['stage'])
            if marker != last:
                print('%s: %s' % marker, flush=True)
                last = marker
            if job['status'] not in ('deploying', 'recovering'):
                print(json.dumps(job, indent=2, ensure_ascii=False))
                return 0 if job['status'] in ('deployed', 'rolled_back') else 1
            time.sleep(0.5)
        raise RuntimeError('operation still pending; inspect gatectl status before retrying')
    return 0


