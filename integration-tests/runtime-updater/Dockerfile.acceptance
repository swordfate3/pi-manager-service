# Test-only image. Pin a dedicated local base tag to its inspected immutable ID.
ARG PI_TEST_BASE=pi-runtime-update-test-base:required
FROM ${PI_TEST_BASE}
USER 1000:1000
RUN npm --prefix /home/node/.local install -g --ignore-scripts --min-release-age=0 \
    --no-audit --no-fund --registry=https://registry.npmjs.org/ \
    @earendil-works/pi-coding-agent@1.3.0 \
    && test "$(pi --version)" = 1.3.0
USER root
RUN find /usr/local/lib/pi-runtime -mindepth 1 -delete
COPY integrations/runtime-updater/pi-runtime/ /usr/local/lib/pi-runtime/
COPY extensions/ /opt/pi-web-ui/extensions/
COPY dist/ /opt/pi-web-ui/dist/
COPY e2e/fixtures/ /opt/pi-web-ui/e2e/fixtures/
COPY node_modules/ws/ /opt/pi-web-ui/node_modules/ws/
RUN install -m 755 /usr/local/lib/pi-runtime/pi-session-control /usr/local/bin/pi-session-control \
    && chown -R root:root /usr/local/lib/pi-runtime /opt/pi-web-ui \
    && chmod -R go-w /usr/local/lib/pi-runtime /opt/pi-web-ui \
    && mkdir -p /run/pi-runtime /home/node/.local /opt/pi-web-ui/node_modules/@earendil-works \
    && chown 1000:1000 /run/pi-runtime /home/node/.local \
    && ln -s /home/node/.local/lib/node_modules/@earendil-works/pi-coding-agent /opt/pi-web-ui/node_modules/@earendil-works/pi-coding-agent \
    && ln -s /home/node/.local/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai /opt/pi-web-ui/node_modules/@earendil-works/pi-ai
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/pi-entrypoint"]
