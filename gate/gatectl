def terminal_preflight(image):
    """One absolute host budget includes the fixed admin exec and all reads."""
    from gate.terminal_contract import pairs, nonfinite
    if not re.fullmatch('sha256:[0-9a-f]{64}', image):
        raise ValueError('immutable terminal image required')
    deadline = time.monotonic() + 2
    process = subprocess.Popen([os.environ.get('PI_PIRUN_DOCKER_BIN', 'docker'), 'exec', '-i', GATE, '/usr/bin/python3', '-m',
                                'gate.admin', 'terminal-preflight', '--json-stdin'],
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        process.stdin.write(json.dumps({'image': image}).encode())
        process.stdin.close()
        raw = bytearray()
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise ValueError('terminal preflight unavailable')
                block = os.read(process.stdout.fileno(), 4097 - len(raw))
                if not block:
                    break
                raw.extend(block)
                if len(raw) > 4096:
                    raise ValueError('terminal preflight limit')
        if process.wait(timeout=max(0.001, deadline-time.monotonic())) or time.monotonic() >= deadline:
            raise ValueError('terminal preflight unavailable')
        value = json.loads(raw.decode('utf-8', 'strict'), object_pairs_hook=pairs, parse_constant=nonfinite)
        if (not isinstance(value, dict) or set(value) != {'v', 'profile', 'image', 'instanceId', 'ready'} or
                type(value['v']) is not int or value['v'] != 1 or value['profile'] != 'web-terminal-v1' or
                value['image'] != image or value['ready'] is not True or
                not isinstance(value['instanceId'], str) or not re.fullmatch('[0-9a-f]{32}', value['instanceId'])):
            raise ValueError('terminal preflight unavailable')
        return value
    finally:
        if process.poll() is None:
            process.kill()
        process.wait()
        process.stdout.close()
        if not process.stdin.closed:
            process.stdin.close()


def docker(*args, data=None, timeout=30):
    result = subprocess.run(['docker', *args], input=data, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=timeout)
    if result.returncode:
        raise RuntimeError('Docker/admin operation failed; use gatectl status and container health for diagnosis')
    return result.stdout


def admin(command, identifier=None, commit=None, plan=None, payload=None):
    args = ['exec', GATE, '/usr/bin/python3', '-m', 'gate.admin', command]
    if payload is not None:
        args.insert(1, '-i')
        args.append('--json-stdin')
    if identifier:
        args.append(identifier)
    if commit:
        args.extend(('--commit', commit))
    if plan:
        args.extend(('--plan', plan))
    return json.loads(docker(*args, data=json.dumps(payload).encode() if payload is not None else None))


def read_definition(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError('definition must be a regular file')
        raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError('definition exceeds limit')
    return json.loads(raw)


def check_upgrade_ready():
    # An inaccessible daemon is not the same as an absent gate.
    existing = docker('ps', '-a', '--filter', 'name=^/' + GATE + '$', '--format', '{{.ID}}').split()
    if not existing:
        return
    if len(existing) != 1:
        raise RuntimeError('ambiguous gate identity')
    info = json.loads(docker('inspect', GATE))
    if not info[0]['State']['Running']:
        raise RuntimeError('existing gate is stopped; restore the reviewed gate and inspect state before upgrade')
    status = admin('status')
    jobs = status.get('active', status['requests'])
    if (status.get('lifecycle_active') or status.get('runtime_active') or
            any(job['status'] in ('deploying', 'recovering', 'recovery_required') for job in jobs)):
        raise RuntimeError('deployment or recovery active; do not replace gate')
    return True


def finish_upgrade(identifier):
    status = admin('upgrade-status')
    reservation = status.get('reservation')
    if not reservation or reservation['id'] != identifier:
        raise RuntimeError('upgrade reservation changed')
    info = json.loads(docker('inspect', GATE))
    if (len(info) != 1 or info[0]['State']['Running'] is not True or
            info[0]['Image'] != reservation['image']):
        raise RuntimeError('replacement image is not the reserved image')
    return admin('upgrade-finish', payload={'id': identifier})


def export_lifecycle(destination):
    export_credential(destination, 'lifecycle-export')


def export_credential(destination, command):
    """Create once under a non-symlinked private host directory; never echo token."""
    if command not in ('lifecycle-export', 'hub-management-export'):
        raise ValueError('invalid credential export')
    path = Path(destination)
    if not path.is_absolute() or '..' in path.parts or path.name in ('', '.', '..'):
        raise ValueError('absolute new credential path required')
    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
        info = os.fstat(directory)
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ValueError('credential directory must be owned and not writable by others')
        descriptor = os.open(path.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                             0o600, dir_fd=directory)
        with os.fdopen(descriptor, 'w') as stream:
            value = admin(command, payload={})
            if (not isinstance(value, dict) or set(value) != {'token'} or
                    not isinstance(value['token'], str) or not re.fullmatch('[0-9a-f]{64}', value['token'])):
                raise ValueError('invalid exported credential')
            os.fchmod(stream.fileno(), 0o600)
            json.dump(value, stream)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.fsync(directory)
    finally:
        os.close(directory)
    print('独立凭据已写入指定的0600文件；不会显示凭据，不会启用策略。')


def install_client(container):
    if not re.fullmatch('pi-docker-pi-run-[0-9a-f]+', container):
        raise ValueError('choose an existing ordinary pirun container')
    info = json.loads(docker('inspect', '--format', '{{json .Mounts}}', container))
    if not any(m.get('Name') == 'pi-home' and m['Destination'] == '/home/node/.pi' for m in info):
        raise ValueError('selected Pi does not use the expected shared agent volume')
    credential = admin('export-client')
    payload = {'credential': credential, 'script': (ROOT / 'gate/client.py').read_text()}
    installer = r'''
import json,os,pathlib,sys,tempfile
data=json.load(sys.stdin)
base=pathlib.Path('/home/node/.pi/agent/deploy-gate')
base.mkdir(mode=0o700,exist_ok=True)
if base.resolve()!=base: raise ValueError('symlinked client directory refused')
for name,text in [('client.json',json.dumps(data['credential'])+'\n'),('pi-gate.py',data['script'])]:
 fd,tmp=tempfile.mkstemp(prefix='.install-',dir=base)
 with os.fdopen(fd,'w') as stream: stream.write(text)
 os.chmod(tmp,0o700 if name=='pi-gate.py' else 0o600)
 os.replace(tmp,base/name)
bindir=pathlib.Path('/home/node/.local/bin')
if bindir.resolve()!=bindir: raise ValueError('symlinked executable directory refused')
link=bindir/'pi-gate'
if link.exists() and not link.is_symlink(): raise ValueError('existing pi-gate executable refused')
temporary=bindir/('.pi-gate-'+os.urandom(8).hex())
temporary.symlink_to(base/'pi-gate.py')
os.replace(temporary,link)
print('Request-only client installed; no administrator credential was copied.')
'''
    docker('exec', '-i', '--user', '1000:1000', container, '/usr/bin/python3', '-c', installer,
           data=json.dumps(payload).encode())
    print('Pi 申请客户端已安装到共享 pi-home；已有及新 Pi 均可使用，无需重启。')


