# Only source inputs needed by the build are sent to Docker, never local data.
**
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!bin/
!bin/**
!hub/
!hub/**
!manager/
!manager/**
!protocol/
!protocol/**
!gate/
!gate/gate/
!gate/gate/**
!gate/gatectl
!runtime/
!runtime/**
!scripts/
!scripts/**
!tests/
!tests/**
!integration-tests/
!integration-tests/candidate-install/
!integration-tests/candidate-install/fixtures.ts
!integration-tests/fixtures/
!integration-tests/fixtures/*.ts
**/node_modules
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/*credential*.json
**/*.pem
**/*.key
